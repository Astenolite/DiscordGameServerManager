services:
  mc:
    image: itzg/minecraft-server:{{ java_version }}
    container_name: "{{ server_name }}"
    restart: unless-stopped

    ports:
      - "{{ port }}:25565"

    volumes:
      - "{{ container_directory_path }}/data:/data"

    environment:
      EULA: "TRUE"

      TYPE: "{{ server_type }}"
      VERSION: "{{ version }}"
      MEMORY: "{{ memory }}G"

      ENABLE_RCON: "true"

      ENABLE_QUERY: "true"
      QUERY_PORT: "25565"

      MOTD: "{{ server_name }}"
      MAX_PLAYERS: "{{ max_players }}"
      ONLINE_MODE: "{{ online_mode }}"
      DIFFICULTY: "{{ difficulty }}"
      VIEW_DISTANCE: "{{ render_distance }}"

      UID: "1000"
      GID: "1000"
